# .env.example — Copy to .env and fill in all values before running docker compose
# NEVER commit .env to git.

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=expatriate365
MYSQL_USER=expatriate365_user
MYSQL_PASSWORD=change_me_db_password

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ISSUER=Expatriate365
JWT_AUDIENCE=Expatriate365
# Min 32 characters, random string
JWT_SECRET_KEY=change_me_at_least_32_chars_secret_key_here
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# ── Application ───────────────────────────────────────────────────────────────
# Public URL of the app (used for file URLs and CORS)
APP_URL=https://acm365hub.poweryoursaas.com
# Port exposed by the nginx frontend container
# Port exposed by the nginx frontend container
HTTP_PORT=8080

# ── SMTP (set SMTP_ENABLED=true to activate) ──────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=change_me_smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Expatriate365
